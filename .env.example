# --- Required ---------------------------------------------------------------
# Your real OpenAI key. Server-side only; the phone only ever sees a 10-minute
# ephemeral client secret minted from this.
OPENAI_API_KEY=sk-...

# --- Privacy ----------------------------------------------------------------
# Passcode she types once on her phone. Leave empty to disable the lock (dev only).
BUNNY_PASSCODE=
# Random string used to sign the login cookie. `openssl rand -hex 32`
AUTH_SECRET=

# --- Memory (Supabase) -------------------------------------------------------
# Without these, memories live in server RAM and vanish on redeploy/cold start.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional tuning ---------------------------------------------------------
# Realtime voice: alloy, ash, ballad, cedar, coral, echo, marin, sage, shimmer, verse
BUNNY_VOICE=shimmer
REALTIME_MODEL=gpt-realtime-2.1
MEMORY_MODEL=gpt-5.4-mini
# Hard stop for a single call, to keep costs predictable.
NEXT_PUBLIC_MAX_CALL_MINUTES=20
